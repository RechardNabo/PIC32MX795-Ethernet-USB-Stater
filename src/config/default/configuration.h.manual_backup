// *****************************************************************************
// *****************************************************************************
// Section: USB Device Configuration
// *****************************************************************************
// *****************************************************************************

/* Number of endpoints used by the USB device (EP0 + CDC bulk IN + CDC bulk OUT
   + CDC interrupt IN = 4 endpoints, but PIC32MX supports EP0..EP15.
   We need 2 for control + 2 for CDC bulk + 1 for CDC interrupt = 5) */
#define USB_DEVICE_ENDPOINTS_NUMBER   5

/* Endpoint table size: 32 bytes per endpoint, aligned to 512 bytes */
#define USB_DEVICE_ENDPOINT_TABLE_SIZE  (32 * USB_DEVICE_ENDPOINTS_NUMBER)

/* USB Device queue sizes */
#define USB_DEVICE_CDC_QUEUE_DEPTH_READ              1
#define USB_DEVICE_CDC_QUEUE_DEPTH_WRITE             1
#define USB_DEVICE_CDC_QUEUE_DEPTH_SERIAL_STATE      1
#define USB_DEVICE_ENDPOINT_READ_QUEUE_SIZE          1
#define USB_DEVICE_ENDPOINT_WRITE_QUEUE_SIZE         1

/* Number of function drivers registered */
#define USB_DEVICE_FUNCTION_REGISTRATION_COUNT      1

/* Number of configurations */
#define USB_DEVICE_NUM_CONFIGURATIONS               1

/* Number of string descriptors */
#define USB_DEVICE_NUM_STRING_DESCRIPTORS           4

